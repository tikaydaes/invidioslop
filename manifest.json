{
  "manifest_version": 3,
  "name": "InvidioSlop",
  "version": "0.2.0",
  "description": "Hides or marks AI slop on YouTube and Invidious using the community AiSList and YouTube's own AI-content label.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "invidioslop@tikaydaes",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "webRequest",
    "webRequestBlocking",
    "menus",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "src/common.js",
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/common.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "InvidioSlop",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_popup": "src/popup.html"
  }
}
